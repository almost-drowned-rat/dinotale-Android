 #include "ui_config_page_options_menu.h"
 #include "recompui/config.h"
 #include "elements/ui_button.h"
+#include "elements/ui_label.h"
 
 
 namespace recompui {
 
+    // The value beside an option button (config::OptionButton::value), asked again every frame.
+    class OptionButtonValue : public Label {
+        std::function<std::string()> value;
+        std::string shown;
+    protected:
+        std::string_view get_type_name() override { return "OptionButtonValue"; }
+        void process_event(const Event &e) override {
+            if (e.type == EventType::Update) {
+                std::string now = value();
+                if (now != shown) {
+                    shown = now;
+                    set_text(shown);
+                }
+                queue_update();
+            }
+        }
+    public:
+        OptionButtonValue(ResourceId rid, Element *parent, std::function<std::string()> value)
+            : Label(rid, parent, LabelStyle::Normal), value(std::move(value)) {
+            shown = this->value();
+            set_text(shown);
+            queue_update();
+        }
+    };
+
+    static void add_option_buttons(ContextId context, Element *parent, const std::string &option_id, bool before) {
+        const std::vector<config::OptionButton> *option_buttons = recompui::config::get_option_buttons(option_id);
+        if (option_buttons == nullptr) {
+            return;
+        }
+        for (const config::OptionButton &option_button : *option_buttons) {
+            if (option_button.before != before) {
+                continue;
+            }
+            Element *row = context.create_element<Element>(parent);
+            row->set_display(Display::Flex);
+            row->set_flex_direction(FlexDirection::Row);
+            row->set_align_items(AlignItems::Center);
+            row->set_margin_bottom(16.0f);
+            if (option_button.gap_before) {
+                row->set_margin_top(56.0f);
+            }
+            Button *button = context.create_element<Button>(row, option_button.label, ButtonStyle::Secondary, ButtonSize::Large);
+            button->set_width(480.0f);
+            std::function<void()> callback = option_button.callback;
+            button->add_pressed_callback([callback]() { callback(); });
+            if (option_button.value) {
+                Element *value = context.create_element<OptionButtonValue>(row, option_button.value);
+                value->set_margin_left(32.0f);
+            }
+        }
+    }
