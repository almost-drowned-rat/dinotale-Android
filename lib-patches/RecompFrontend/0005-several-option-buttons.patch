 namespace recompui {
 
+    // The value beside an option button (config::OptionButton::value), asked again every frame.
+    class OptionButtonValue : public Label {
+        std::function<std::string()> value;
+        std::string shown;
+    protected:
+        std::string_view get_type_name() override { return "OptionButtonValue"; }
+        void process_event(const Event &e) override {
+            if (e.type == EventType::Update) {
+                std::string now = value();
+                if (now != shown) {
+                    shown = now;
+                    set_text(shown);
+                }
+                queue_update();
+            }
+        }
+    public:
+        OptionButtonValue(ResourceId rid, Element *parent, std::function<std::string()> value)
+            : Label(rid, parent, LabelStyle::Normal), value(std::move(value)) {
+            shown = this->value();
+            set_text(shown);
+            queue_update();
+        }
+    };
+
+    // Y on a controller (Android) puts the focused option back to its default: an option's (and a button's) element
+    // carries the key of its reset action (attribute data-reset); ui_state.cpp looks it up from the focused element
+    // upwards. Element::set_attribute is protected: reached through a class derived from Element.
+    struct ElementAttribute : Element {
+        static void set(Element *element, const Rml::String &key, const Rml::String &value) {
+            (element->*(&ElementAttribute::set_attribute))(key, value);
+        }
+    };
+    static std::unordered_map<std::string, std::function<void()>> reset_actions;
+    static void set_reset_action(Element *element, std::function<void()> action) {
+        static int next_key = 0;
+        std::string key = std::to_string(++next_key);
+        reset_actions[key] = std::move(action);
+        ElementAttribute::set(element, "data-reset", key);
+    }
+
+    static void reset_option_to_default(recomp::config::Config *config, const std::string &option_id) {
+        const recomp::config::ConfigOption &option = config->get_option(option_id);
+        recomp::config::ConfigValueVariant value;
+        if (const auto *e = std::get_if<recomp::config::ConfigOptionEnum>(&option.variant)) value = e->default_value;
+        else if (const auto *n = std::get_if<recomp::config::ConfigOptionNumber>(&option.variant)) value = n->default_value;
+        else if (const auto *s = std::get_if<recomp::config::ConfigOptionString>(&option.variant)) value = s->default_value;
+        else if (const auto *b = std::get_if<recomp::config::ConfigOptionBool>(&option.variant)) value = b->default_value;
+        else return;
+        config->update_option_value(option_id, value);
+    }
+
+    bool reset_focused_option(Rml::Element *focused) {
+        for (Rml::Element *e = focused; e != nullptr; e = e->GetParentNode()) {
+            if (const Rml::Variant *key = e->GetAttribute("data-reset")) {
+                auto it = reset_actions.find(key->Get<Rml::String>());
+                if (it != reset_actions.end()) {
+                    it->second();
+                    return true;
+                }
+            }
+        }
+        return false;
+    }
+
+    static void add_option_buttons(ContextId context, Element *parent, const std::string &option_id, bool before) {
+        const std::vector<config::OptionButton> *option_buttons = recompui::config::get_option_buttons(option_id);
+        if (option_buttons == nullptr) {
+            return;
+        }
+        for (const config::OptionButton &option_button : *option_buttons) {
+            if (option_button.before != before) {
+                continue;
+            }
+            Element *row = context.create_element<Element>(parent);
+            row->set_display(Display::Flex);
+            row->set_flex_direction(FlexDirection::Row);
+            row->set_align_items(AlignItems::Center);
+            row->set_margin_bottom(16.0f);
+            if (option_button.gap_before) {
+                row->set_margin_top(56.0f);
+            }
+            if (option_button.reset) {
+                set_reset_action(row, option_button.reset);
+            }
+            Button *button = context.create_element<Button>(row, option_button.label, ButtonStyle::Secondary, ButtonSize::Large);
+            button->set_width(480.0f);
+            std::function<void()> callback = option_button.callback;
+            button->add_pressed_callback([callback]() { callback(); });
+            if (option_button.value) {
+                Element *value = context.create_element<OptionButtonValue>(row, option_button.value);
+                value->set_margin_left(32.0f);
+            }
+        }
+    }
