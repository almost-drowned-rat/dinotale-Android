+// Android ports: the right stick scrolls the menu - the scrolling box around the focused (or hovered) element.
+static float right_stick_scroll_y = 0.0f;
+
+static void scroll_with_right_stick(Rml::Context* context) {
+    using sclock = std::chrono::steady_clock;
+    static sclock::time_point last = sclock::now();
+    sclock::time_point now = sclock::now();
+    float dt = std::min(std::chrono::duration<float>(now - last).count(), 0.1f);
+    last = now;
+    float v = right_stick_scroll_y;
+    if (context == nullptr || std::fabs(v) < 0.2f) {
+        return;
+    }
+    Rml::Element* e = context->GetFocusElement();
+    if (e == nullptr || e == context->GetRootElement()) {
+        e = context->GetHoverElement();
+    }
+    while (e != nullptr && !(e->GetScrollHeight() > e->GetClientHeight() + 1.0f)) {
+        e = e->GetParentNode();
+    }
+    if (e != nullptr) {
+        float sign = v < 0 ? -1.0f : 1.0f;
+        float amount = (std::fabs(v) - 0.2f) / 0.8f;                       // past the dead zone, 0..1
+        e->SetScrollTop(e->GetScrollTop() + sign * amount * amount * 1600.0f * context->GetDensityIndependentPixelRatio() * dt);
+    }
+}
