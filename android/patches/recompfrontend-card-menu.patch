+
+std::string ConfigOptionCard::value_text() {
+    const recomp::config::ConfigOption &option = config->get_option(option_index);
+    recomp::config::ConfigValueVariant v = get_value();
+    if (option.type == recomp::config::ConfigOptionType::Enum) {
+        const auto &e = std::get<recomp::config::ConfigOptionEnum>(option.variant);
+        if (const uint32_t *u = std::get_if<uint32_t>(&v)) {
+            auto it = e.find_option_from_value(*u);
+            if (it != e.options.end()) {
+                return it->name;
+            }
+        }
+        return "";
+    }
+    if (option.type == recomp::config::ConfigOptionType::Number) {
+        const auto &n = std::get<recomp::config::ConfigOptionNumber>(option.variant);
+        double d = 0.0;
+        if (const double *p = std::get_if<double>(&v)) {
+            d = *p;
+        }
+        char buf[64];
+        snprintf(buf, sizeof buf, "%.*f%s", n.precision, d, n.percent ? "%" : "");
+        return buf;
+    }
+    if (const std::string *s = std::get_if<std::string>(&v)) {
+        return *s;
+    }
+    return "";
+}
+
+void ConfigOptionCard::step(int direction) {
+    if (get_disabled()) {
+        return;
+    }
+    const recomp::config::ConfigOption &option = config->get_option(option_index);
+    recomp::config::ConfigValueVariant v = get_value();
+    switch (option.type) {
+        case recomp::config::ConfigOptionType::Bool: {
+            const bool *b = std::get_if<bool>(&v);
+            set_option_value(option_id, !(b != nullptr && *b));
+            break;
+        }
+        case recomp::config::ConfigOptionType::Enum: {
+            const auto &e = std::get<recomp::config::ConfigOptionEnum>(option.variant);
+            const uint32_t *u = std::get_if<uint32_t>(&v);
+            int i = 0;
+            for (size_t k = 0; k < e.options.size(); k++) {
+                if (u != nullptr && e.options[k].value == *u) {
+                    i = static_cast<int>(k);
+                }
+            }
+            int n = i + direction;
+            while (n >= 0 && n < static_cast<int>(e.options.size()) && config->get_enum_option_disabled(option_index, n)) {
+                n += direction;
+            }
+            if (n < 0 || n >= static_cast<int>(e.options.size()) || n == i) {
+                return;
+            }
+            set_option_value(option_id, e.options[n].value);
+            break;
+        }
+        case recomp::config::ConfigOptionType::Number: {
+            const auto &num = std::get<recomp::config::ConfigOptionNumber>(option.variant);
+            const double *p = std::get_if<double>(&v);
+            const double cur = p != nullptr ? *p : num.default_value;
+            const double s = num.step > 0.0 ? num.step : 1.0;
+            double nv = cur + direction * s;
+            if (nv < num.min) nv = num.min;
+            if (nv > num.max) nv = num.max;
+            if (nv == cur) {
+                return;
+            }
+            set_option_value(option_id, nv);
+            break;
+        }
+        default:
+            return;
+    }
+    update_value();
+}
+
+void ConfigOptionCard::set_editing(bool enable) {
+    editing = enable;
+    if (chevron_left == nullptr) {
+        return;
+    }
+    if (enable) {
+        value_area->set_border_color(theme::color::Primary);
+        chevron_left->set_color(theme::color::Primary);
+        chevron_right->set_color(theme::color::Primary);
+    } else {
+        value_area->set_border_color(pill_bg);
+        chevron_left->set_color(card_arrow);
+        chevron_right->set_color(card_arrow);
+    }
+}
+
+void ConfigOptionCard::process_event(const Event &e) {
+    switch (e.type) {
+    case EventType::Hover:
+        if (std::get<EventHover>(e.variant).active) {
+            on_hover(option_id);
+        }
+        break;
+    case EventType::Focus: {
+        const bool active = std::get<EventFocus>(e.variant).active;
+        set_style_enabled(focus_state, active);
+        if (active) {
+            on_hover(option_id);
+            scroll_into_view();
+        } else {
+            set_editing(false);
+        }
+        break;
+    }
+    case EventType::Click: {
+        const recomp::config::ConfigOption &option = config->get_option(option_index);
+        if (get_disabled()) {
+            break;
+        }
+        focus();
+        if (option.type == recomp::config::ConfigOptionType::Bool) {
+            step(1);
+            break;
+        }
+        const EventClick &c = std::get<EventClick>(e.variant);
+        const float left = value_area->get_absolute_left();
+        const float width = value_area->get_client_width();
+        if (c.x > 0.0f && c.x >= left && width > 0.0f) {
+            // touch on the value: its left third steps back, the rest forward
+            step(c.x < left + width / 3.0f ? -1 : 1);
+        } else {
+            set_editing(!editing); // A (Return) or a tap on the name: take / release the value
+        }
+        break;
+    }
+    case EventType::Navigate:
+        if (editing) {
+            const NavDirection dir = std::get<EventNavigate>(e.variant).direction;
+            if (dir == NavDirection::Left) {
+                step(-1);
+            } else if (dir == NavDirection::Right) {
+                step(1);
+            }
+        }
+        break;
+    default:
+        break;
+    }
+}
+
+void ConfigOptionCard::update_value() {
+    if (knob != nullptr) {
+        recomp::config::ConfigValueVariant v = get_value();
+        const bool *b = std::get_if<bool>(&v);
+        const bool on = b != nullptr && *b;
+        value_area->set_background_color(on ? theme::color::Primary : theme::color::Transparent);
+        if (!on) {
+            value_area->set_background_color(track_off);
+        }
+        knob->set_left(on ? track_w - knob_gap - knob_size : knob_gap);
+    } else if (value_label != nullptr) {
+        value_label->set_text(value_text());
+    }
+}
+
+void ConfigOptionCard::update_disabled() {
+    const bool disabled = get_disabled();
+    set_style_enabled(disabled_state, disabled);
+    if (chevron_left != nullptr) {
+        chevron_left->set_display(disabled ? Display::None : Display::Block);
+        chevron_right->set_display(disabled ? Display::None : Display::Block);
+    }
+}
+
+} // namespace recompui
+#endif // __ANDROID__
