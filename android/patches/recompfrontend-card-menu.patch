+
+static jclass mc_java(JNIEnv *env) {
+    static jclass cls = nullptr;
+    if (cls != nullptr || mc_java_class.empty() || env == nullptr) {
+        return cls;
+    }
+    jobject activity = static_cast<jobject>(SDL_AndroidGetActivity());
+    if (activity == nullptr) {
+        return nullptr;
+    }
+    jclass act_cls = env->GetObjectClass(activity);
+    jmethodID get_loader = env->GetMethodID(act_cls, "getClassLoader", "()Ljava/lang/ClassLoader;");
+    jobject loader = env->CallObjectMethod(activity, get_loader);
+    jclass loader_cls = env->FindClass("java/lang/ClassLoader");
+    jmethodID load = env->GetMethodID(loader_cls, "loadClass", "(Ljava/lang/String;)Ljava/lang/Class;");
+    jstring name = env->NewStringUTF(mc_java_class.c_str());
+    jobject found = env->CallObjectMethod(loader, load, name);
+    if (env->ExceptionCheck()) {
+        env->ExceptionClear();
+        found = nullptr;
+    }
+    if (found != nullptr) {
+        cls = static_cast<jclass>(env->NewGlobalRef(found));
+        env->DeleteLocalRef(found);
+    }
+    env->DeleteLocalRef(name);
+    env->DeleteLocalRef(loader_cls);
+    env->DeleteLocalRef(loader);
+    env->DeleteLocalRef(act_cls);
+    env->DeleteLocalRef(activity);
+    return cls;
+}
+
+// { title, then per item: kind ("v" a value, "a" an action), title, value }; cached for max_age_ms
+static const std::vector<std::string> &mc_java_items(const std::string &page, int max_age_ms) {
+    static std::map<std::string, std::pair<mc_clock::time_point, std::vector<std::string>>> cache;
+    auto &slot = cache[page];
+    const auto now = mc_clock::now();
+    if (max_age_ms > 0 && !slot.second.empty() && now - slot.first < std::chrono::milliseconds(max_age_ms)) {
+        return slot.second;
+    }
+    slot.first = now;
+    slot.second.clear();
+    JNIEnv *env = static_cast<JNIEnv *>(SDL_AndroidGetJNIEnv());
+    jclass cls = mc_java(env);
+    if (cls == nullptr) {
+        return slot.second;
+    }
+    static jmethodID m = env->GetStaticMethodID(cls, "bridgeItems", "(Ljava/lang/String;)[Ljava/lang/String;");
+    jstring jid = env->NewStringUTF(page.c_str());
+    auto arr = static_cast<jobjectArray>(env->CallStaticObjectMethod(cls, m, jid));
+    if (env->ExceptionCheck()) {
+        env->ExceptionClear();
+        arr = nullptr;
+    }
+    if (arr != nullptr) {
+        const jsize n = env->GetArrayLength(arr);
+        for (jsize i = 0; i < n; i++) {
+            auto js = static_cast<jstring>(env->GetObjectArrayElement(arr, i));
+            const char *c = js ? env->GetStringUTFChars(js, nullptr) : nullptr;
+            slot.second.emplace_back(c ? c : "");
+            if (c) env->ReleaseStringUTFChars(js, c);
+            if (js) env->DeleteLocalRef(js);
+        }
+        env->DeleteLocalRef(arr);
+    }
+    env->DeleteLocalRef(jid);
+    return slot.second;
+}
+
+static void mc_java_act(const std::string &page, int index, int op) {
+    JNIEnv *env = static_cast<JNIEnv *>(SDL_AndroidGetJNIEnv());
+    jclass cls = mc_java(env);
+    if (cls == nullptr) {
+        return;
+    }
+    static jmethodID m = env->GetStaticMethodID(cls, "bridgeAct", "(Ljava/lang/String;II)V");
+    jstring jid = env->NewStringUTF(page.c_str());
+    env->CallStaticVoidMethod(cls, m, jid, index, op);
+    if (env->ExceptionCheck()) {
+        env->ExceptionClear();
+    }
+    env->DeleteLocalRef(jid);
+    mc_java_acted = mc_clock::now();
+}
+
+static std::string mc_java_take_pushed() {
+    JNIEnv *env = static_cast<JNIEnv *>(SDL_AndroidGetJNIEnv());
+    jclass cls = mc_java(env);
+    if (cls == nullptr) {
+        return "";
+    }
+    static jmethodID m = env->GetStaticMethodID(cls, "bridgeTakePushed", "()Ljava/lang/String;");
+    auto js = static_cast<jstring>(env->CallStaticObjectMethod(cls, m));
+    if (env->ExceptionCheck()) {
+        env->ExceptionClear();
+        return "";
+    }
+    std::string r;
+    if (js != nullptr) {
+        const char *c = env->GetStringUTFChars(js, nullptr);
+        r = c ? c : "";
+        env->ReleaseStringUTFChars(js, c);
+        env->DeleteLocalRef(js);
+    }
+    return r;
+}
+
+static bool mc_java_take_close() {
+    JNIEnv *env = static_cast<JNIEnv *>(SDL_AndroidGetJNIEnv());
+    jclass cls = mc_java(env);
+    if (cls == nullptr) {
+        return false;
+    }
+    static jmethodID m = env->GetStaticMethodID(cls, "bridgeTakeClose", "()Z");
+    const bool r = env->CallStaticBooleanMethod(cls, m);
+    if (env->ExceptionCheck()) {
+        env->ExceptionClear();
+        return false;
+    }
+    return r;
+}
+
+std::vector<MenuCardEntry> config::java_menu_cards(const std::string &page) {
+    std::vector<MenuCardEntry> out;
+    const std::vector<std::string> items = mc_java_items(page, 0);
+    for (size_t i = 0; 1 + 3 * i + 2 < items.size(); i++) {
+        const int index = static_cast<int>(i);
+        MenuCardEntry e;
+        e.label = items[2 + 3 * i];
+        // the Java menu marks its links with "  ›": the card shows its own
+        const std::string link = "›";
+        if (e.label.size() >= link.size() && e.label.compare(e.label.size() - link.size(), link.size(), link) == 0) {
+            e.label.erase(e.label.size() - link.size());
+            while (!e.label.empty() && e.label.back() == ' ') e.label.pop_back();
+        }
+        const std::string &kind = items[1 + 3 * i];
+        if (kind == "v" || kind == "s") {
+            e.is_switch = kind == "s";
+            e.value = [page, index]() {
+                const auto &now = mc_java_items(page, 200);
+                const size_t k = 3 + 3 * static_cast<size_t>(index);
+                return k < now.size() ? now[k] : std::string();
+            };
+            e.step = [page, index](int d) { mc_java_act(page, index, d); };
+            e.reset = [page, index]() { mc_java_act(page, index, 2); };
+        } else {
+            e.run = [page, index]() { mc_java_act(page, index, 0); };
+        }
+        out.push_back(std::move(e));
+    }
+    return out;
+}
