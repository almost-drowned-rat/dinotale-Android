+#if defined(__ANDROID__)
+// Android ports: a finger drag scrolls the menu - the scrolling box under the finger. Once the finger has moved past a
+// small threshold the touch is a drag: RmlUi gets the button released far outside (so nothing under the finger is
+// pressed), and the rest of the drag and the real release stay with the scrolling. True = the event is taken.
+static bool touch_drag_scroll(Rml::Context* context, const SDL_Event& ev) {
+    static bool down = false, dragging = false;
+    static float start_y = 0.0f, last_y = 0.0f;
+    static Rml::Element* target = nullptr;
+    if (context == nullptr) {
+        return false;
+    }
+    switch (ev.type) {
+    case SDL_EventType::SDL_MOUSEBUTTONDOWN:
+        if (ev.button.button != SDL_BUTTON_LEFT) {
+            return false;
+        }
+        down = true;
+        dragging = false;
+        start_y = last_y = static_cast<float>(ev.button.y);
+        target = context->GetElementAtPoint(Rml::Vector2f(static_cast<float>(ev.button.x), static_cast<float>(ev.button.y)));
+        while (target != nullptr && !(target->GetScrollHeight() > target->GetClientHeight() + 1.0f)) {
+            target = target->GetParentNode();
+        }
+        return false;
+    case SDL_EventType::SDL_MOUSEMOTION: {
+        if (!down || target == nullptr) {
+            return false;
+        }
+        const float y = static_cast<float>(ev.motion.y);
+        if (!dragging && std::fabs(y - start_y) > 24.0f * context->GetDensityIndependentPixelRatio()) {
+            dragging = true;
+            context->ProcessMouseMove(-10000, -10000, 0);        // away from what the finger was on ...
+            context->ProcessMouseButtonUp(0, 0);                 // ... then let go there, so it is not pressed
+        }
+        if (dragging) {
+            target->SetScrollTop(target->GetScrollTop() - (y - last_y));
+            last_y = y;
+            return true;
+        }
+        last_y = y;
+        return false;
+    }
+    case SDL_EventType::SDL_MOUSEBUTTONUP:
+        if (ev.button.button != SDL_BUTTON_LEFT) {
+            return false;
+        }
+        down = false;
+        if (dragging) {
+            dragging = false;
+            target = nullptr;
+            return true;
+        }
+        target = nullptr;
+        return false;
+    default:
+        return false;
+    }
+}
+#endif
