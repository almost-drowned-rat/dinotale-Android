+static size_t mc_option_index(const recomp::config::Config &c, const std::string &option_id) {
+    auto schema = c.get_config_schema();
+    for (size_t i = 0; i < schema.options.size(); i++) {
+        if (schema.options[i].id == option_id) {
+            return i;
+        }
+    }
+    return SIZE_MAX;
+}
+
+MenuCardEntry config::option_card(const std::string &config_id, const std::string &option_id) {
+    MenuCardEntry e;
+    recomp::config::Config *c = &config::get_config(config_id);
+    const size_t index = mc_option_index(*c, option_id);
+    if (index == SIZE_MAX) {
+        e.hidden = []() { return true; };
+        return e;
+    }
+    const recomp::config::ConfigOption &option = c->get_option(index);
+    e.label = option.name;
+    e.description = option.description;
+    e.config_id = config_id;
+    if (option.type == recomp::config::ConfigOptionType::String) {
+        // text (e.g. cheat codes): the value shortened on the card, the text field on its own page
+        e.value = [c, option_id]() {
+            recomp::config::ConfigValueVariant v = c->requires_confirmation ? c->get_temp_option_value(option_id)
+                                                                            : c->get_option_value(option_id);
+            const std::string *t = std::get_if<std::string>(&v);
+            if (t == nullptr || t->empty()) return std::string("(empty)");
+            return t->size() > 28 ? t->substr(0, 28) + "..." : *t;
+        };
+        e.sub_page = [c, index, option_id, config_id](ContextId context, Element *parent) {
+            context.create_element<ConfigOptionString>(parent, option_id, index, c,
+                [c, config_id](const std::string &id, recomp::config::ConfigValueVariant v) {
+                    c->set_option_value(id, v);
+                    if (config_id != mc_confirm_config) c->save_config();
+                },
+                [](const std::string &) {});
+        };
+        e.hidden = [c, index]() { return c->is_config_option_hidden(index); };
+        e.disabled = [c, index]() { return c->is_config_option_disabled(index); };
+        return e;
+    }
+    auto get = [c, option_id]() {
+        return c->requires_confirmation ? c->get_temp_option_value(option_id) : c->get_option_value(option_id);
+    };
+    auto set = [c, option_id, config_id](recomp::config::ConfigValueVariant v) {
+        c->set_option_value(option_id, v);
+        if (config_id != mc_confirm_config) {
+            c->save_config();
+        }
+    };
+    e.value = [c, index, get]() -> std::string {
+        const recomp::config::ConfigOption &o = c->get_option(index);
+        recomp::config::ConfigValueVariant v = get();
+        if (const auto *en = std::get_if<recomp::config::ConfigOptionEnum>(&o.variant)) {
+            if (const uint32_t *u = std::get_if<uint32_t>(&v)) {
+                auto it = en->find_option_from_value(*u);
+                if (it != en->options.end()) return it->name;
+            }
+            return "";
+        }
+        if (const auto *n = std::get_if<recomp::config::ConfigOptionNumber>(&o.variant)) {
+            const double *d = std::get_if<double>(&v);
+            char buf[64];
+            snprintf(buf, sizeof buf, "%.*f%s", n->precision, d ? *d : 0.0, n->percent ? "%" : "");
+            return buf;
+        }
+        if (std::holds_alternative<recomp::config::ConfigOptionBool>(o.variant)) {
+            const bool *b = std::get_if<bool>(&v);
+            return b != nullptr && *b ? "On" : "Off";
+        }
+        if (const std::string *s = std::get_if<std::string>(&v)) return *s;
+        return "";
+    };
+    e.step = [c, index, get, set](int dir) {
+        const recomp::config::ConfigOption &o = c->get_option(index);
+        recomp::config::ConfigValueVariant v = get();
+        if (const auto *en = std::get_if<recomp::config::ConfigOptionEnum>(&o.variant)) {
+            const uint32_t *u = std::get_if<uint32_t>(&v);
+            int i = 0;
+            for (size_t k = 0; k < en->options.size(); k++) {
+                if (u != nullptr && en->options[k].value == *u) i = static_cast<int>(k);
+            }
+            int n = i + dir;
+            while (n >= 0 && n < static_cast<int>(en->options.size()) && c->get_enum_option_disabled(index, n)) n += dir;
+            if (n >= 0 && n < static_cast<int>(en->options.size()) && n != i) set(en->options[n].value);
+        } else if (const auto *num = std::get_if<recomp::config::ConfigOptionNumber>(&o.variant)) {
+            const double *p = std::get_if<double>(&v);
+            const double cur = p != nullptr ? *p : num->default_value;
+            double nv = cur + dir * (num->step > 0.0 ? num->step : 1.0);
+            nv = std::min(std::max(nv, num->min), num->max);
+            if (nv != cur) set(nv);
+        } else if (std::holds_alternative<recomp::config::ConfigOptionBool>(o.variant)) {
+            const bool *b = std::get_if<bool>(&v);
+            set(!(b != nullptr && *b));
+        }
+    };
+    e.reset = [c, index, set]() {
+        const recomp::config::ConfigOption &o = c->get_option(index);
+        if (const auto *en = std::get_if<recomp::config::ConfigOptionEnum>(&o.variant)) set(en->default_value);
+        else if (const auto *n = std::get_if<recomp::config::ConfigOptionNumber>(&o.variant)) set(n->default_value);
+        else if (const auto *b = std::get_if<recomp::config::ConfigOptionBool>(&o.variant)) set(b->default_value);
+    };
+    if (std::holds_alternative<recomp::config::ConfigOptionBool>(option.variant)) {
+        e.is_switch = true;
+    } else if (const auto *en = std::get_if<recomp::config::ConfigOptionEnum>(&option.variant)) {
+        e.is_switch = en->options.size() == 2 && (en->options[0].name == "Off" || en->options[0].name == "On");
+    }
+    e.hidden = [c, index]() { return c->is_config_option_hidden(index); };
+    e.disabled = [c, index]() { return c->is_config_option_disabled(index); };
+    return e;
+}
+
+std::vector<MenuCardEntry> config::config_cards(const std::string &config_id) {
+    std::vector<MenuCardEntry> out;
+    auto schema = config::get_config(config_id).get_config_schema();
+    // an option's own buttons (config::add_option_button) as cards before / after it: nothing of the page is lost
+    auto buttons = [&out](const std::string &option_id, bool before) {
+        const std::vector<OptionButton> *list = config::get_option_buttons(option_id);
+        if (list == nullptr) return;
+        for (const OptionButton &b : *list) {
+            if (b.before != before) continue;
+            MenuCardEntry e;
+            e.label = b.label;
+            while (!e.label.empty() && e.label.back() == '.') e.label.pop_back();
+            e.run = b.callback;
+            e.value = b.value;
+            e.reset = b.reset;
+            out.push_back(std::move(e));
+        }
+    };
+    for (auto &o : schema.options) {
+        buttons(o.id, true);
+        out.push_back(option_card(config_id, o.id));
+        buttons(o.id, false);
+    }
+    return out;
+}
