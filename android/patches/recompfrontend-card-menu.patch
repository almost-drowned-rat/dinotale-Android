+        static const char *const words_edit[2][2] = { { "Change", "Done" }, { "Default", "Done" } };
+        for (int r = 0; r < 2; r++) {
+            Element *row = context.create_element<Element>(hints, 0, "div", false);
+            row->set_display(Display::Flex);
+            row->set_flex_direction(FlexDirection::Row);
+            row->set_align_items(AlignItems::Center);
+            row->set_gap(14.0f);
+            for (int k = 0; k < 2; k++) {
+                Label *key = context.create_element<Label>(row, (mc_editing ? keys_edit : keys_list)[r][k], theme::Typography::LabelSM);
+                key->set_color(mc_text);
+                key->set_background_color(Color{ 46, 50, 60, 255 });
+                key->set_border_radius(8.0f);
+                key->set_padding_left(10.0f);
+                key->set_padding_right(10.0f);
+                key->set_padding_top(3.0f);
+                key->set_padding_bottom(3.0f);
+                Label *word = context.create_element<Label>(row, (mc_editing ? words_edit : words_list)[r][k], theme::Typography::LabelSM);
+                word->set_color(mc_dim);
+                word->set_margin_right(k == 0 ? 18.0f : 0.0f);
+            }
+        }
+    }
+
+    void describe(const std::string &text) {
+        description->set_text_unsafe(text);
+    }
+
+    void push(const MenuCardEntry &e) {
+        push_next.push_back(Level{ e.label, e.sub_entries, e.sub_page, 0 });
+    }
+    void pop() { pop_next = true; }
+    void acted() { rebuild_at = mc_clock::now() + std::chrono::milliseconds(250); }
+
+    int focused_index() {
+        for (size_t i = 0; i < cards.size(); i++) {
+            if (cards[i]->is_style_enabled(focus_state)) return static_cast<int>(i);
+        }
+        return -1;
+    }
+
+    void render() {
+        ContextId context = get_current_context();
+        Element *left = get_body()->get_left();
+        left->clear_children();
+        cards.clear();
+        left->set_padding(0.0f);
+        left->set_display(Display::Block);
+        left->set_position(Position::Relative);
+        left->set_height(100.0f, Unit::Percent);
+        Level &level = levels.back();
+        if (level.page) {
+            // a page of its own (the bindings): "‹ Back" over it, the page fills the rest
+            left->set_display(Display::Flex);
+            left->set_flex_direction(FlexDirection::Column);
+            left->set_as_navigation_container(NavigationType::Vertical);
+            MenuCardEntry back;
+            back.label = "\u2039  Back";
+            back.run = [this]() { pop(); };
+            cards.push_back(context.create_element<MenuCard>(left, std::move(back), this));
+            cards.back()->set_margin_left(16.0f);
+            cards.back()->set_margin_right(16.0f);
+            cards.back()->set_margin_top(16.0f);
+            Element *own = context.create_element<Element>(left, 0, "div", false);
+            own->set_flex_grow(1.0f);
+            own->set_flex_shrink(1.0f);
+            own->set_min_height(0.0f);
+            own->set_width(100.0f, Unit::Percent);
+            own->set_display(Display::Flex);
+            own->set_flex_direction(FlexDirection::Column);
+            level.page(context, own);
+            cards.back()->focus();
+            describe("");
+            return;
+        }
+        Element *scroll = context.create_element<Element>(left, 0, "div", false);
+        scroll->set_display(Display::Block);
+        scroll->set_width(100.0f, Unit::Percent);
+        scroll->set_min_height(100.0f, Unit::Percent);
+        scroll->set_max_height(100.0f, Unit::Percent);
+        scroll->set_padding(16.0f);
+        scroll->set_overflow_y(Overflow::Auto);
+        scroll->set_as_navigation_container(NavigationType::Vertical);
+        std::vector<MenuCardEntry> entries;
+        if (levels.size() > 1) {
+            MenuCardEntry back;
+            back.label = "‹  Back";
+            back.run = [this]() { pop(); };
+            entries.push_back(std::move(back));
+            entries.push_back(config::header_card(level.title));
+        }
+        if (level.list) {
+            for (auto &e : level.list()) entries.push_back(std::move(e));
+        }
+        for (auto &e : entries) {
+            if (e.header) {
+                Label *h = context.create_element<Label>(scroll, e.label, theme::Typography::LabelSM);
+                h->set_color(theme::color::Primary);
+                h->set_margin_top(cards.empty() ? 4.0f : 28.0f);
+                h->set_margin_bottom(12.0f);
+                h->set_margin_left(8.0f);
+                continue;
+            }
+            cards.push_back(context.create_element<MenuCard>(scroll, std::move(e), this));
+        }
+        for (MenuCard *c : cards) c->refresh();
+        const int f = std::min(level.focus, static_cast<int>(cards.size()) - 1);
+        if (f >= 0) cards[f]->focus();
+        describe("");
+    }
+
+protected:
+    std::string_view get_type_name() override { return "MenuCardPage"; }
+    void process_event(const Event &e) override {
+        if (e.type != EventType::Update) return;
+        queue_update();
+        const auto now = mc_clock::now();
+        if (now - mc_java_acted < std::chrono::seconds(2)) {
+            if (mc_java_take_close()) {
+                config::close();
+                return;
+            }
+            std::string pushed = mc_java_take_pushed();
+            if (!pushed.empty()) {
+                const auto items = mc_java_items(pushed, 0);
+                MenuCardEntry e2;
+                e2.label = items.empty() ? std::string() : items[0];
+                e2.sub_entries = [pushed]() { return config::java_menu_cards(pushed); };
+                push(e2);
+            }
+        }
+        if (pop_next || !push_next.empty() || (rebuild_at != mc_clock::time_point{} && now >= rebuild_at)) {
+            levels.back().focus = std::max(0, focused_index());
+            if (pop_next && levels.size() > 1) levels.pop_back();
+            for (auto &l : push_next) levels.push_back(std::move(l));
+            pop_next = false;
+            push_next.clear();
+            rebuild_at = {};
+            render();
+        }
+        for (MenuCard *c : cards) c->refresh();
+        if (hints_editing != mc_editing) render_hints();
+        if (apply_button != nullptr) {
+            const bool dirty = config::get_config(confirm_config).is_dirty();
+            if (apply_button->is_enabled() != dirty) apply_button->set_enabled(dirty);
+        }
+    }
+};
+
+MenuCard::MenuCard(ResourceId rid, Element *parent, MenuCardEntry e, MenuCardPage *page)
+    : Element(rid, parent, Events(EventType::Hover, EventType::Focus, EventType::Click, EventType::Navigate), "div", false),
+      entry(std::move(e)), page(page) {
+    set_display(Display::Flex);
+    set_flex_direction(FlexDirection::Row);
+    set_align_items(AlignItems::Center);
+    set_justify_content(JustifyContent::SpaceBetween);
+    set_padding_top(12.0f);
+    set_padding_bottom(12.0f);
+    set_padding_left(28.0f);
+    set_padding_right(20.0f);
+    set_margin_bottom(12.0f);
+    set_min_height(78.0f);
+    set_border_radius(14.0f);
+    set_background_color(mc_card_bg);
+    set_border_left_width(6.0f);
+    set_border_left_color(mc_card_bg);
+    set_cursor(Cursor::Pointer);
+    enable_focus();
+    set_nav_none(NavDirection::Left);
+    set_nav_none(NavDirection::Right);
+    focus_style.set_background_color(mc_card_focus_bg);
+    focus_style.set_border_left_color(theme::color::Primary);
+    disabled_style.set_opacity(0.45f);
+    add_style(&focus_style, { focus_state });
+    add_style(&disabled_style, { disabled_state });
+    if (entry.reset) {
+        set_reset_action(this, entry.reset);
+    }
+
+    ContextId context = get_current_context();
+    Label *name = context.create_element<Label>(this, entry.label, theme::Typography::LabelMD);
+    name->set_color(mc_text);
+    right = context.create_element<Element>(this, 0, "div", false);
+    right->set_display(Display::Flex);
+    right->set_flex_direction(FlexDirection::Row);
+    right->set_align_items(AlignItems::Center);
+    right->set_flex_shrink(0.0f);
+    if (is_pill()) {
+        // a switch (On / Off) or a pill ‹ value ›, whichever the value is
+        track = context.create_element<Element>(right, 0, "div", false);
+        track->set_position(Position::Relative);
+        track->set_width(mc_track_w);
+        track->set_height(mc_track_h);
+        track->set_border_radius(mc_track_h / 2.0f);
+        track->set_background_color(mc_track_off);
+        knob = context.create_element<Element>(track, 0, "div", false);
+        knob->set_position(Position::Absolute);
+        knob->set_top(mc_knob_gap);
+        knob->set_left(mc_knob_gap);
+        knob->set_width(mc_knob);
+        knob->set_height(mc_knob);
+        knob->set_border_radius(mc_knob / 2.0f);
+        knob->set_background_color(mc_text);
+        pill = context.create_element<Element>(right, 0, "div", false);
+        pill->set_display(Display::Flex);
+        pill->set_flex_direction(FlexDirection::Row);
+        pill->set_align_items(AlignItems::Center);
+        pill->set_justify_content(JustifyContent::SpaceBetween);
+        pill->set_width(440.0f);
+        pill->set_height(54.0f);
+        pill->set_padding_left(22.0f);
+        pill->set_padding_right(22.0f);
+        pill->set_border_radius(27.0f);
+        pill->set_border_width(2.0f);
+        pill->set_border_color(mc_pill_bg);
+        pill->set_background_color(mc_pill_bg);
+        chev_l = context.create_element<Label>(pill, "‹", theme::Typography::Header3);
+        chev_l->set_color(mc_arrow);
+        value_label = context.create_element<Label>(pill, "", theme::Typography::LabelMD);
+        value_label->set_color(theme::color::Primary);
+        chev_r = context.create_element<Label>(pill, "›", theme::Typography::Header3);
+        chev_r->set_color(mc_arrow);
+    } else {
+        if (entry.value) {
+            readout = context.create_element<Label>(right, "", theme::Typography::LabelMD);
+            readout->set_color(mc_dim);
+            readout->set_margin_right(20.0f);
+        }
+        if (is_link() || (!entry.run && !entry.value)) {
+            Label *arrow = context.create_element<Label>(right, "›", theme::Typography::Header3);
+            arrow->set_color(mc_arrow);
+            arrow->set_margin_right(12.0f);
+        }
+    }
+}
+
+MenuCard::~MenuCard() {
+    if (mc_focused_card == this) mc_focused_card = nullptr;
+    if (editing) mc_editing = false;
+}
+
+void MenuCard::refresh() {
+    const bool hidden = entry.hidden && entry.hidden();
+    set_display(hidden ? Display::None : Display::Flex);
+    if (hidden) return;
+    set_style_enabled(disabled_state, entry.disabled && entry.disabled());
+    if (!entry.value) return;
+    std::string v = entry.value();
+    if (v == shown) return;
+    shown = v;
+    if (readout != nullptr) {
+        readout->set_text(v);
+    } else if (pill != nullptr) {
+        const bool sw = entry.is_switch;
+        track->set_display(sw ? Display::Block : Display::None);
+        pill->set_display(sw ? Display::None : Display::Flex);
+        if (sw) {
+            const bool on = v == "On" || v == "shown";
+            track->set_background_color(on ? Color{} : mc_track_off);
+            if (on) track->set_background_color(theme::color::Primary);
+            knob->set_left(on ? mc_track_w - mc_knob_gap - mc_knob : mc_knob_gap);
+        } else {
+            value_label->set_text(v);
+        }
+    }
+}
+
+void MenuCard::set_editing(bool on) {
+    editing = on;
+    mc_editing = on;
+    if (pill == nullptr) return;
+    pill->set_border_color(on ? Color{} : mc_pill_bg);
+    if (on) pill->set_border_color(theme::color::Primary);
+    if (on) {
+        chev_l->set_color(theme::color::Primary);
+        chev_r->set_color(theme::color::Primary);
+    } else {
+        chev_l->set_color(mc_arrow);
+        chev_r->set_color(mc_arrow);
+    }
+}
+
+void MenuCard::step(int d) {
+    if (entry.step) {
+        entry.step(d);
+        refresh();
+        page->acted();
+    }
+}
+
+void MenuCard::process_event(const Event &e) {
+    const bool disabled = entry.disabled && entry.disabled();
+    switch (e.type) {
+    case EventType::Hover:
+        if (std::get<EventHover>(e.variant).active) page->describe(entry.description);
+        break;
+    case EventType::Focus: {
+        const bool active = std::get<EventFocus>(e.variant).active;
+        set_style_enabled(focus_state, active);
+        if (active) {
+            mc_focused_card = this;
+        } else if (mc_focused_card == this) {
+            mc_focused_card = nullptr;
+        }
+        if (active) {
+            page->describe(entry.description);
+            scroll_into_view();
+        } else {
+            set_editing(false);
+        }
+        break;
+    }
+    case EventType::Click: {
+        if (disabled) break;
+        focus();
+        if (is_link()) {
+            page->push(entry);
+        } else if (entry.run) {
+            entry.run();
+            page->acted();
+        } else if (is_pill()) {
+            if (entry.is_switch) {
+                step(1);
+                break;
+            }
+            const EventClick &c = std::get<EventClick>(e.variant);
+            const float left = pill->get_absolute_left();
+            const float width = pill->get_client_width();
+            if (c.x > 0.0f && c.x >= left && width > 0.0f) {
+                step(c.x < left + width / 3.0f ? -1 : 1);   // a tap on the value: left third back, the rest on
+            } else {
+                set_editing(!editing);                       // A or a tap on the name: take / let go of the value
+            }
+        }
+        break;
+    }
+    case EventType::Navigate:
+        if (editing && !disabled) {
+            const NavDirection dir = std::get<EventNavigate>(e.variant).direction;
+            if (dir == NavDirection::Left) step(-1);
+            else if (dir == NavDirection::Right) step(1);
+        }
+        break;
+    default:
+        break;
+    }
+}
+
+bool MenuCardPage::back() {
+    for (MenuCard *c : cards) {
+        if (c->editing) {
+            c->set_editing(false);
+            return true;
+        }
+    }
+    if (levels.size() > 1 && !pop_next) {
+        pop();
+        return true;
+    }
+    return false;
+}
+
+int config::card_back() {
+    if (mc_open_page != nullptr && mc_open_page->back()) return 1;
+    return mc_focused_card != nullptr ? 0 : -1;
+}
+
+void config::create_card_tab(const std::string &name, const std::string &id, MenuCardList entries,
+                             const std::string &confirm_config_id) {
+    config::create_tab(
+        name,
+        id,
+        [entries, confirm_config_id, id](ContextId context, Element *parent) {
+            try {
+                context.create_element<MenuCardPage>(parent, entries, confirm_config_id);
+            } catch (const std::exception &ex) {
+                __android_log_print(ANDROID_LOG_ERROR, "recompui", "card tab %s: %s", id.c_str(), ex.what());
+            }
+        },
+        [name, confirm_config_id](TabCloseContext close_context) {
+            if (confirm_config_id.empty()) return true;
+            recomp::config::Config &c = config::get_config(confirm_config_id);
+            if (!c.is_dirty()) return true;
+            std::string cid = confirm_config_id;
+            recompui::open_choice_prompt(
+                name + " options have unapplied changes.", "Would you like to apply or discard the changes?",
+                "Apply", "Discard",
+                [cid, close_context]() {
+                    config::get_config(cid).save_config();
+                    if (close_context == TabCloseContext::ModalClose) config::close();
+                },
+                [cid, close_context]() {
+                    config::get_config(cid).revert_temp_config();
+                    if (close_context == TabCloseContext::ModalClose) config::close();
+                },
+                recompui::ButtonStyle::Success, recompui::ButtonStyle::Danger, true);
+            return false;
+        },
+        [](TabCloseContext) { config::save_controls_config(); });
+}
+
+} // namespace recompui
+#endif // __ANDROID__
