+#ifdef __ANDROID__
+// The N64 ports' Android menu (MenuCards look): one option as a card - the name on the left, the value on the right as
+// "< value >" (enum / number) or a switch (bool). The card itself takes the focus: A flips a switch or takes the value
+// for left / right (A or B ends it), Y resets it (the reset-y action of the page). Touch: tap a switch, or the left /
+// right end of a value.
+class ConfigOptionCard : public ConfigOptionElement {
+protected:
+    Element *value_area = nullptr;   // the pill or the switch's track
+    Element *knob = nullptr;         // the switch's knob
+    Label *value_label = nullptr;
+    Label *chevron_left = nullptr;
+    Label *chevron_right = nullptr;
+    Style focus_style;
+    Style disabled_style;
+    bool editing = false;
+
+    void step(int direction);
+    void set_editing(bool enable);
+    std::string value_text();
+    virtual void process_event(const Event &e) override;
+    std::string_view get_type_name() override { return "ConfigOptionCard"; }
+public:
+    ConfigOptionCard(
+        ResourceId rid,
+        Element *parent,
+        std::string option_id,
+        size_t option_index,
+        const recomp::config::Config *config,
+        set_option_value_t set_option_value,
+        on_option_hover_t on_hover
+    );
+    void update_value() override;
+    void update_disabled() override;
+    bool is_editing() const { return editing; }
+    // B while editing ends it (true = taken).
+    bool end_editing() { if (!editing) return false; set_editing(false); return true; }
+};
+#endif
 } // namespace recompui
